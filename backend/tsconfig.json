{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"],
    "typeRoots": ["./types", "../frontend/node_modules/@types"]
  },
  "include": ["./**/*.ts", "./global.d.ts"],
  "exclude": ["node_modules", "dist"]
}
